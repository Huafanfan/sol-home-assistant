# 仅填入本机的 .env；真实密钥绝不提交到仓库。
# 腾讯云凭据仅由 Voice Gateway 使用，绝不下发到 Satellite。
VOICE_PROVIDER=tencent_cloud
TENCENT_CLOUD_APP_ID=
TENCENT_CLOUD_SECRET_ID=
TENCENT_CLOUD_SECRET_KEY=
TENCENT_ASR_PROFILE=standard
TENCENT_TTS_VOICE_TYPE=

# 文本深度推理仅通过可替换的 OpenAI-compatible 适配器调用。
# 例如本地 CLIProxyAPI；可以填写 API 根路径或完整的 Chat Completions 路径。
# 部署前必须验证实际模型、流式与工具能力。
TEXT_REASONER_PROVIDER=openai_compatible
TEXT_REASONER_BASE_URL=
TEXT_REASONER_API_KEY=
TEXT_REASONER_MODEL=
TEXT_REASONER_TIMEOUT_MS=30000
TEXT_REASONER_MAX_TOKENS=256

# 首版不允许文本推理提供方接收音频，也不启用联网搜索。
TEXT_REASONER_ALLOW_AUDIO=false
SEARCH_PROVIDER=disabled

# 仅本地开发使用；生产部署应使用独立的密钥管理机制。
SOL_ENV=development
SOL_DATA_DIR=./data
